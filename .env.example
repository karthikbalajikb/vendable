# Copy to .env and fill in. Never commit .env.

# --- Prava (payment rail) ---
# Sign up: https://dashboard.prava.space  |  Docs: https://docs.prava.space
# Use your SECRET key (server-side): sandbox = sk_test_*, production = sk_live_*
PRAVA_API_KEY=
# API host (note the ".api."): sandbox = https://sandbox.api.prava.space , prod = https://api.prava.space
PRAVA_BASE_URL=https://sandbox.api.prava.space
# 0 = MOCK (offline demo, default). Set to 1 to make REAL Prava API calls with the key above.
PRAVA_LIVE=0
# Buyer/agent-owner identity attached to Prava sessions (required by the API).
PRAVA_USER_ID=vendable-demo
PRAVA_USER_EMAIL=demo@vendable.dev

# --- LLM (buyer/merchant agent reasoning) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Senso (trust / verified-source gate) ---
# API key from https://senso.ai (sent as X-API-Key). To verify a merchant, ingest its
# trust facts ONCE via the Senso CLI, then the dashboard queries them (grounded):
#   npx @senso-ai/cli ingest upload <merchant-trust-profile.md>
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1

# --- webcmd (no-API storefront operation) ---
# Install globally: npm i -g @agentrhq/webcmd   (then: webcmd skills add)
# The platform runs webcmd in MOCK mode by default. Set WEBCMD_LIVE=1 to shell out
# to the real compiled `webcmd <adapter> <command>` once you have authored the adapter.
WEBCMD_LIVE=0
# Checkout places a REAL order, so it stays simulated even when WEBCMD_LIVE=1.
# Only set this to 1 after authoring a test-safe checkout adapter.
WEBCMD_CHECKOUT_LIVE=0
# Override the webcmd binary (e.g. "npx webcmd") if it is not on PATH.
WEBCMD_BIN=webcmd

# --- Fulfillment: create the real order in the merchant store after Prava settles ---
# Your store exposes one authenticated endpoint (reference handler:
# platform/store-integration/agent-orders.route.ts). Leave blank to stay payment-only.
STORE_ORDER_URL=
# Shared secret sent as `Authorization: Bearer <secret>`. Use the SAME value your
# store checks (its AGENT_ORDER_SECRET). Generate a long random string.
STORE_ORDER_SECRET=

# --- Demo target ---
DEMO_STORE_URL=https://theprintsmithstore.com/

# --- Waitlist / leads (landing hero URL capture) ---
# Optional durable mirror (Google Sheet / Zapier / Airtable webhook). Blank = local file only.
WAITLIST_WEBHOOK_URL=
# Token to view leads at /api/leads?token=... (generate a long random string).
LEADS_ADMIN_TOKEN=

# --- Supabase (stores waitlist leads) ---
# From: https://app.supabase.com -> Project -> Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: SERVER-SIDE ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name (default "waitlist").
SUPABASE_WAITLIST_TABLE=waitlist
